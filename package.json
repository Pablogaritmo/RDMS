{
  "name": "rdms",
  "private": true,
  "version": "0.1.0",
  "description": "Rocket Development Management System - CRATER / GIA / UCR",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @rdms/api dev",
    "dev:web": "pnpm --filter @rdms/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @rdms/api db:generate",
    "db:migrate": "pnpm --filter @rdms/api db:migrate",
    "db:seed": "pnpm --filter @rdms/api db:seed",
    "db:reset": "pnpm --filter @rdms/api db:reset",
    "start": "node apps/api/dist/index.js"
  }
}
