# --- Base de datos ---
# Local (docker compose): coincide con docker-compose.yml
DATABASE_URL=postgres://rdms:rdms@localhost:5432/rdms

# --- API ---
PORT=3000
# Origen del frontend en desarrollo (Vite). En producción el API sirve el SPA, así que no hace falta.
CORS_ORIGIN=http://localhost:5173
# "production" activa cookies Secure y sirve apps/web/dist como SPA
NODE_ENV=development
# Si el API está detrás de un proxy HTTPS (Fly.io, Railway, nginx) deja true para cookies Secure.
TRUST_PROXY=false

# --- Seed inicial (solo se usa al ejecutar `pnpm db:seed`) ---
ADMIN_EMAIL=admin@crater.ucr.ac.cr
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrador
# Carga el proyecto de demostración "IREC 2027" con usuarios demo (password: demo1234)
SEED_DEMO=true
